# Réglages de fastlane deliver pour la compilation « iOS · fiche et soumission à Apple » (.github/workflows/ios-soumission.yml).
# Les textes de la fiche sont dans fastlane/metadata/fr-FR ; les captures, la confidentialité et le classement par âge
# restent gérés dans App Store Connect.
app_identifier "io.github.pierreroubydroid.chiffres"
metadata_path "./fastlane/metadata"
skip_binary_upload true
skip_screenshots true
force true
run_precheck_before_submit false
automatic_release false
submission_information({
  export_compliance_uses_encryption: false,
  add_id_info_uses_idfa: false,
  content_rights_contains_third_party_content: true,
  content_rights_has_rights: true
})
